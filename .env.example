# ─────────────────────────────────────────────────────────────────────────────
# ChadWallet environment variables
#
# Copy this file to `.env.local` and fill in the values.
#   cp .env.example .env.local
#
# Every key is OPTIONAL: the app boots with mock data for any service whose key
# is missing, so you can wire services in one at a time. See src/lib/env.ts.
# ─────────────────────────────────────────────────────────────────────────────

# ── BirdEye — token data, prices, OHLCV, trending, holders, trades ───────────
# https://birdeye.so/data-api  (free tier available)
BIRDEYE_API_KEY=

# ── Solana RPC (Alchemy) — on-chain reads, deposit detection ─────────────────
# https://www.alchemy.com/rpc-api  → create a Solana Mainnet app, copy HTTPS URL
SOLANA_RPC_URL=

# ── Privy — auth (Google/Apple) + embedded Solana wallets ────────────────────
# https://dashboard.privy.io  → App settings
NEXT_PUBLIC_PRIVY_APP_ID=
PRIVY_APP_SECRET=

# ── Supabase (Postgres) — users, positions, trades, networth snapshots ───────
# https://supabase.com/dashboard  → Project Settings → API Keys
# Uses Supabase's new key format: publishable (public) + secret (server-only).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLIC_KEY=
SUPABASE_SECRET_KEY=
# Postgres connection string for running migrations (`pnpm migrate`).
# Supabase Dashboard → Connect → "Session pooler" → copy URI, paste password.
DATABASE_URL=

# ── Cloudflare R2 (S3-compatible) — image uploads (avatars) ──────────────────
# Cloudflare → R2: create a bucket, enable its public dev URL, and make an
# "Object Read & Write" API token. Account ID is on the R2 overview page.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=chadwallet-avatars
R2_PUBLIC_URL=https://pub-xxxxxxxx.r2.dev

# ── App ──────────────────────────────────────────────────────────────────────
# Public base URL of the deployment (used for callbacks/links).
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ── Gas relayer — a funded SOL hot wallet that sponsors users gas ────────────
# Generate a keypair, fund its address, put the base58 secret here.
RELAYER_SECRET_KEY=
